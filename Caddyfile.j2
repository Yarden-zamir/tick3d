{# host() keeps tick3d.yarden-zamir.com for prod and gives pr-<number>.tick3d.yarden-zamir.com
   to each preview. KitSHn then serves all previews from one wildcard certificate. #}
{{ host("tick3d.yarden-zamir.com") }} {
    {# A deploy removes the socket and starts a new site container: about 12 s without a socket. Caddy holds
       each request until the socket answers again, so a move or a page load in that time waits, without a 502.
       A failed connection is always tried again, also for a POST. #}
    reverse_proxy unix//{{ paths.default_socket }} {
        lb_try_duration 30s
        lb_try_interval 250ms
    }
}
{# The old short address of the share page (it was the testing page), for production only. It keeps the links sent
   before the rename working, with their query. host() would give each preview a name such as
   pr-<number>.tick3d.yarden-zamir.com, so this block names the host itself.
   Revisit: remove it when testing.tick3d.yarden-zamir.com gets no requests for a few months. #}
{% if environment == "prod" %}
testing.tick3d.yarden-zamir.com {
    {# {?query} is the query with its "?", or nothing for no query, so an invite link keeps its "by". #}
    redir https://tick3d.yarden-zamir.com/share{?query} 302
}
{% endif %}
