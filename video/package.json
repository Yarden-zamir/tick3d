{
  "name": "tick3d-video",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "license": "MIT",
  "scripts": {
    "studio": "remotion studio src/index.ts",
    "audio": "node scripts/audio.ts",
    "video": "node scripts/audio.ts && node scripts/render.ts",
    "tutorial": "node scripts/tutorial.ts",
    "check": "tsc && npm run lint && vitest run",
    "lint": "oxlint -c ../.oxlintrc.json --type-aware --deny-warnings src scripts && knip"
  },
  "dependencies": {
    "@react-three/fiber": "9.8.1",
    "@remotion/bundler": "4.0.534",
    "@remotion/cli": "4.0.534",
    "@remotion/renderer": "4.0.534",
    "@remotion/three": "4.0.534",
    "node-web-audio-api": "2.2.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "remotion": "4.0.534",
    "three": "0.186.1"
  },
  "devDependencies": {
    "@types/node": "^26.6.4",
    "@types/react": "19.3.0",
    "@types/three": "0.186.0",
    "knip": "^6.40.0",
    "oxlint": "^1.87.0",
    "oxlint-tsgolint": "^7.0.2003",
    "typescript": "^7.0.2",
    "vitest": "^5.0.3"
  },
  "knip": {
    "entry": [
      "src/index.ts",
      "scripts/*.ts",
      "src/**/*.test.ts"
    ],
    "project": [
      "src/**/*.{ts,tsx}",
      "scripts/**/*.ts"
    ]
  }
}
