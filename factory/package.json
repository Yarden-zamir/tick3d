{
  "name": "tick3d-factory",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "description": "The tick3d repository as an automated 3D factory. A dev toy: not part of the site or the API.",
  "scripts": {
    "scan": "node --experimental-strip-types --no-warnings=ExperimentalWarning scan/scan.ts",
    "predev": "npm run scan",
    "dev": "vite",
    "prebuild": "npm run scan",
    "build": "tsc && vite build",
    "check": "tsc",
    "toy": "npm run build"
  },
  "dependencies": {
    "three": "0.186.1"
  },
  "devDependencies": {
    "@types/node": "26.6.5",
    "@types/three": "0.186.0",
    "typescript": "7.0.2",
    "vite": "8.3.4"
  }
}
