# Caddy for a LAN host (compose.lan.yml): plain HTTP on port 8080, on every address of this computer.
{
	auto_https off
	admin off
}

:8080 {
	handle /api/* {
		reverse_proxy api:8080
	}

	handle {
		root * /srv
		encode zstd gzip
		header /assets/* Cache-Control "public, max-age=31536000, immutable"
		# The hidden stats page.
		rewrite /stats /stats.html
		# The ear training page.
		rewrite /sound-training /sound-training.html
		# The Voice room.
		rewrite /sound-input /sound-input.html
		file_server
	}
}
