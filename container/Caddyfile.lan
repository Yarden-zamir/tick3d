# Caddy for a LAN host (compose.lan.yml): plain HTTP on port 8080, on every address of this computer.
{
	auto_https off
	admin off
}

:8080 {
	handle /api/* {
		# A restart of `api` holds the requests until the new process answers, without a 502.
		reverse_proxy api:8080 {
			lb_try_duration 30s
			lb_try_interval 250ms
		}
	}

	handle {
		root * /srv
		encode zstd gzip
		header /assets/* Cache-Control "public, max-age=31536000, immutable"
		# Digital Asset Links of the Android app (src/assetlinks.ts), as in container/Caddyfile.
		header /.well-known/assetlinks.json Content-Type application/json
		# A page address without .html, such as /stats, serves the page file of the same name (src/pages.ts).
		@page file {path}.html
		rewrite @page {path}.html
		file_server
	}
}
