# Caddy for a LAN host (compose.lan.yml): plain HTTP on port 8080, on every address of this computer.
{
	auto_https off
	admin off
}

:8080 {
	handle /api/* {
		reverse_proxy api:8080
	}

	handle {
		root * /srv
		encode zstd gzip
		header /assets/* Cache-Control "public, max-age=31536000, immutable"
		file_server
	}
}
