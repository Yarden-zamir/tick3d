# Caddy inside the container. The host Caddy (Caddyfile.j2) terminates TLS and proxies
# the public hostname to this Unix socket, so this file serves plain HTTP on the socket.
{
	auto_https off
	admin off
	# Only the host Caddy reaches the socket, so its X-Forwarded-For is true. Without this, Caddy
	# drops the header on a socket connection, and the API sees one address for every player.
	servers {
		trusted_proxies_unix
	}
}

http:// {
	# Caddy binds the KitSHn socket directly and removes a stale socket file left by a
	# previous container, so no socat sidecar is needed. 0666 lets the host Caddy connect.
	bind unix/{$KITSHN_DEFAULT_SOCKET}|0666

	# Online sessions. Caddy flushes the text/event-stream responses at once, so live updates are not held back.
	handle /api/* {
		reverse_proxy api:8080
	}

	# The page. `encode` sits in this block only, so it never buffers the API event streams.
	handle {
		root * /srv

		# Compress the text files of the page.
		encode zstd gzip {
			match {
				header Content-Type text/html*
				header Content-Type text/css*
				header Content-Type application/javascript*
				header Content-Type text/javascript*
				header Content-Type image/svg+xml*
			}
		}

		# Vite puts a content hash in every asset file name, so assets never change.
		header /assets/* Cache-Control "public, max-age=31536000, immutable"
		header / Cache-Control "no-cache"

		# The hidden stats page. Search engines must not list it.
		# Caddy sets headers before the rewrite, so the matcher names both paths.
		@stats path /stats /stats.html
		rewrite /stats /stats.html
		header @stats Cache-Control "no-cache"
		header @stats X-Robots-Tag "noindex, nofollow"

		# The service worker, its Workbox runtime and the manifest have fixed names. A browser must
		# check them on every visit, or a new version never reaches a player who has the old one.
		@pwa path /sw.js /workbox-*.js /manifest.webmanifest
		header @pwa Cache-Control "no-cache"

		file_server
	}
}
