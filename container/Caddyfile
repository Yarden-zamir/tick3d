# Caddy inside the container. The host Caddy (Caddyfile.j2) terminates TLS and proxies
# the public hostname to this Unix socket, so this file serves plain HTTP on the socket.
{
	auto_https off
	admin off
	# Only the host Caddy reaches the socket, so its X-Forwarded-For is true. Without this, Caddy
	# drops the header on a socket connection, and the API sees one address for every player.
	servers {
		trusted_proxies_unix
	}
}

http:// {
	# Caddy binds the KitSHn socket directly and removes a stale socket file left by a
	# previous container, so no socat sidecar is needed. 0666 lets the host Caddy connect.
	bind unix/{$KITSHN_DEFAULT_SOCKET}|0666

	# The page /testing moved to /share. The redirect keeps the links sent before the rename working, with their query
	# (an invite link keeps its "by"). Revisit: remove it when /testing gets no requests for a few months.
	@testing path /testing /testing/ /testing.html
	redir @testing /share{?query} 302

	# Online sessions. Caddy flushes the text/event-stream responses at once, so live updates are not held back.
	handle /api/* {
		# A restart of `api` (a crash, or a deploy) holds the requests until the new process answers, without a 502.
		reverse_proxy api:8080 {
			lb_try_duration 30s
			lb_try_interval 250ms
		}
	}

	# The page. `encode` sits in this block only, so it never buffers the API event streams.
	handle {
		root * /srv

		# Compress the text files of the page.
		encode zstd gzip {
			match {
				header Content-Type text/html*
				header Content-Type text/css*
				header Content-Type application/javascript*
				header Content-Type text/javascript*
				header Content-Type image/svg+xml*
				header Content-Type application/manifest+json*
				# favicon.ico holds raw bitmaps, so it shrinks to half.
				header Content-Type image/vnd.microsoft.icon*
			}
		}

		# Vite puts a content hash in every asset file name, so assets never change.
		header /assets/* Cache-Control "public, max-age=31536000, immutable"
		# Pages have fixed names, so a browser checks them on every visit. This covers /index.html too.
		@pages path / *.html
		header @pages Cache-Control "no-cache"

		# A page address without .html, such as /stats, serves the page file of the same name (src/pages.ts).
		# Caddy sets headers before the rewrite. The file matcher checks {path}.html, so it covers the header too.
		@page file {path}.html
		rewrite @page {path}.html
		header @page Cache-Control "no-cache"

		# The service worker, its imported script, its Workbox runtime and the manifest have fixed names. A browser must
		# check them on every visit, or a new version never reaches a player who has the old one.
		@pwa path /sw.js /sw-share-reminder.js /workbox-*.js /manifest.webmanifest
		header @pwa Cache-Control "no-cache"

		# Digital Asset Links of the Android app (src/assetlinks.ts). Android requires JSON, without a redirect.
		header /.well-known/assetlinks.json Content-Type application/json

		file_server
	}
}
