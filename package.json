{
  "name": "tick3d",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "license": "MIT",
  "scripts": {
    "dev": "vite",
    "check": "tsc && npm run lint && vitest run",
    "test": "vitest run",
    "lint": "oxlint --type-aware --deny-warnings src server e2e vite.config.ts && stylelint \"src/**/*.css\" && html-validate *.html && knip",
    "build": "tsc && vite build",
    "api": "DB_PATH=./dev.duckdb node server/main.ts",
    "e2e": "playwright test -c e2e/playwright.config.ts"
  },
  "dependencies": {
    "@duckdb/node-api": "1.5.6-r.1"
  },
  "devDependencies": {
    "@playwright/test": "1.63.0",
    "@seriousme/openapi-schema-validator": "^2.11.0",
    "@types/node": "^26.6.4",
    "@types/pngjs": "^6.0.5",
    "ajv": "^8.20.0",
    "fake-indexeddb": "^6.2.5",
    "happy-dom": "^20.14.5",
    "html-validate": "^11.16.2",
    "jsqr": "^1.4.0",
    "knip": "^6.39.0",
    "oxlint": "^1.86.0",
    "oxlint-tsgolint": "^7.0.2003",
    "pngjs": "^7.0.0",
    "qrcode-generator": "^2.0.4",
    "stylelint": "^17.16.0",
    "stylelint-config-recommended": "^18.0.0",
    "typescript": "^7.0.2",
    "vite": "^8.3.2",
    "vite-plugin-pwa": "^2.0.0",
    "vitest": "^5.0.3",
    "workbox-window": "^7.4.1"
  },
  "knip": {
    "entry": [
      "e2e/*.spec.ts"
    ],
    "playwright": false
  }
}
